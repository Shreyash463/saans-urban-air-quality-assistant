{
  "components": {
    "schemas": {
      "AirQualityReading": {
        "additionalProperties": false,
        "description": "Air quality reading returned by /api/air-quality and embedded in PlanResponse.",
        "properties": {
          "aqi": {
            "maximum": 500.0,
            "minimum": 0.0,
            "title": "Aqi",
            "type": "integer"
          },
          "city": {
            "maxLength": 120,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "dominantPollutant": {
            "maxLength": 32,
            "minLength": 1,
            "title": "Dominantpollutant",
            "type": "string"
          },
          "source": {
            "enum": [
              "live",
              "demo"
            ],
            "title": "Source",
            "type": "string"
          },
          "sourceDetail": {
            "anyOf": [
              {
                "maxLength": 120,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sourcedetail"
          },
          "updatedAt": {
            "maxLength": 64,
            "title": "Updatedat",
            "type": "string"
          }
        },
        "required": [
          "city",
          "aqi",
          "dominantPollutant",
          "updatedAt",
          "source"
        ],
        "title": "AirQualityReading",
        "type": "object"
      },
      "Alternative": {
        "additionalProperties": false,
        "description": "Low-emission lifestyle swap with bounded PM2.5 and CO2 estimates.",
        "properties": {
          "co2SavedKgPerMonth": {
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Co2Savedkgpermonth",
            "type": "integer"
          },
          "current": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Current",
            "type": "string"
          },
          "pm25ReductionPct": {
            "maximum": 95.0,
            "minimum": 0.0,
            "title": "Pm25Reductionpct",
            "type": "integer"
          },
          "swap": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Swap",
            "type": "string"
          },
          "why": {
            "maxLength": 700,
            "minLength": 1,
            "title": "Why",
            "type": "string"
          }
        },
        "required": [
          "current",
          "swap",
          "why",
          "pm25ReductionPct",
          "co2SavedKgPerMonth"
        ],
        "title": "Alternative",
        "type": "object"
      },
      "ChatReply": {
        "additionalProperties": false,
        "description": "Assistant reply payload.",
        "properties": {
          "answer": {
            "maxLength": 2500,
            "minLength": 1,
            "title": "Answer",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "title": "ChatReply",
        "type": "object"
