          "who",
          "howTo",
          "estimatedImpact",
          "effort"
        ],
        "title": "CommunityAction",
        "type": "object"
      },
      "CoordinatesBody": {
        "additionalProperties": false,
        "description": "Ephemeral geolocation coordinates submitted inside a POST JSON body.",
        "properties": {
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon"
        ],
        "title": "CoordinatesBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "additionalProperties": false,
        "description": "Service readiness payload for /api/health.",
        "properties": {
          "commitSha": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Commitsha"
          },
          "dailyBudgetLimit": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dailybudgetlimit"
          },
          "geminiConfigured": {
            "title": "Geminiconfigured",
            "type": "boolean"
          },
          "remainingDailyBudget": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Remainingdailybudget"
          },
          "selectedModel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selectedmodel"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "geminiConfigured"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "IndoorHack": {
        "additionalProperties": false,
        "description": "Practical indoor air-quality improvement action ranked by budget.",
        "properties": {
          "costLevel": {
            "enum": [
              "free",
              "low",
              "medium",
              "high"
            ],
            "title": "Costlevel",
            "type": "string"
          },
          "estimatedBenefit": {
            "maxLength": 400,
            "minLength": 1,
            "title": "Estimatedbenefit",
            "type": "string"
          },
          "howTo": {
            "maxLength": 900,
            "minLength": 1,
            "title": "Howto",
            "type": "string"
          },
          "title": {
            "maxLength": 220,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "title",
          "howTo",
          "estimatedBenefit",
          "costLevel"
        ],
        "title": "IndoorHack",
        "type": "object"
      },
      "PlanRequest": {
        "additionalProperties": false,
        "description": "Plan request body supporting optional ephemeral coordinates without query strings.",
        "properties": {
          "budget": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Budget",
            "type": "string"
          },
          "city": {
            "maxLength": 60,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "commuteKm": {
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Commutekm",
            "type": "integer"
          },
          "commuteMode": {
            "enum": [
              "car",
              "two_wheeler",
              "public_transport",
              "walk_cycle",
              "work_from_home"
            ],
            "title": "Commutemode",
            "type": "string"
          },
          "cookingFuel": {
            "enum": [
              "lpg",
              "induction_electric",
              "piped_gas",
              "biomass_wood"
            ],
            "title": "Cookingfuel",
            "type": "string"
          },
          "coords": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CoordinatesBody"
              },
              {
                "type": "null"
              }
            ]
          },
          "hasAirPurifier": {
            "title": "Hasairpurifier",
            "type": "boolean"
          },
          "hasChildren": {
            "title": "Haschildren",
            "type": "boolean"
          },
          "hasElderly": {
            "title": "Haselderly",
            "type": "boolean"
          },
          "hasRespiratoryCondition": {
            "title": "Hasrespiratorycondition",
            "type": "boolean"
          },
          "homeType": {
            "enum": [
              "apartment",
              "independent_house"
            ],
            "title": "Hometype",
            "type": "string"
          },
          "householdSize": {
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Householdsize",
            "type": "integer"
          },
          "language": {
            "enum": [
              "en",
              "hi"
            ],
            "title": "Language",
            "type": "string"
          },
          "preferCoords": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prefercoords"
          }
        },
        "required": [
          "city",
          "householdSize",
          "hasChildren",
          "hasElderly",
          "hasRespiratoryCondition",
          "commuteMode",
          "commuteKm",
          "homeType",
          "hasAirPurifier",
          "cookingFuel",
          "budget",
          "language"
        ],
        "title": "PlanRequest",
        "type": "object"
      },
      "PlanResponse": {
        "additionalProperties": false,
        "description": "Complete personalized clean-air plan matching src/types/index.ts.",
        "properties": {
          "alternatives": {
            "items": {
              "$ref": "#/components/schemas/Alternative"
            },
            "maxItems": 8,
            "minItems": 1,
            "title": "Alternatives",
            "type": "array"
          },
          "aqi": {
            "$ref": "#/components/schemas/AirQualityReading"
          },
          "communityActions": {
            "items": {
              "$ref": "#/components/schemas/CommunityAction"
            },
            "maxItems": 6,
            "title": "Communityactions",
            "type": "array"
          },
          "disclaimer": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Disclaimer",
            "type": "string"
          },
          "fallbackReason": {
            "anyOf": [
              {
                "enum": [
                  "no_key",
                  "ai_busy",
                  "ai_error"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fallbackreason"
          },
          "generatedBy": {
            "anyOf": [
              {
                "enum": [
                  "gemini",
                  "rules"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Generatedby"
          },
          "healthAdvisory": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Healthadvisory",
            "type": "string"
          },
          "indoorHacks": {
            "items": {
              "$ref": "#/components/schemas/IndoorHack"
            },
            "maxItems": 10,
            "minItems": 1,
            "title": "Indoorhacks",
            "type": "array"
          },
          "maskGuidance": {
            "maxLength": 1500,
            "minLength": 1,
            "title": "Maskguidance",
            "type": "string"
          },
          "retryAfterSeconds": {
            "anyOf": [
              {
                "maximum": 3600.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retryafterseconds"
          },
          "routine": {
            "items": {
              "$ref": "#/components/schemas/RoutineItem"
            },
            "maxItems": 4,
            "minItems": 4,
            "title": "Routine",
            "type": "array"
          },
          "summary": {
            "maxLength": 1500,
            "minLength": 1,
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "aqi",
          "summary",
          "healthAdvisory",
          "routine",
          "indoorHacks",
          "alternatives",
          "maskGuidance",
          "disclaimer"
        ],
        "title": "PlanResponse",
        "type": "object"
      },
      "RoutineItem": {
        "additionalProperties": false,
        "description": "Single time-slot item in the daily clean-air routine.",
        "properties": {
          "detail": {
            "maxLength": 900,
            "minLength": 1,
            "title": "Detail",
            "type": "string"
          },
          "impactNote": {
            "maxLength": 400,
            "minLength": 1,
            "title": "Impactnote",
            "type": "string"
          },
          "timeSlot": {
            "enum": [
              "morning",
              "midday",
              "evening",
              "night"
            ],
            "title": "Timeslot",
            "type": "string"
          },
          "title": {
            "maxLength": 220,
            "minLength": 1,
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "timeSlot",
          "title",
          "detail",
          "impactNote"
        ],
        "title": "RoutineItem",
        "type": "object"
      },
      "UserProfile": {
        "additionalProperties": false,
        "description": "Household lifestyle profile submitted by the frontend.",
        "properties": {
          "budget": {
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Budget",
            "type": "string"
          },
          "city": {
            "maxLength": 60,
            "minLength": 1,
            "title": "City",
            "type": "string"
          },
          "commuteKm": {
            "maximum": 300.0,
            "minimum": 0.0,
            "title": "Commutekm",
            "type": "integer"
          },
          "commuteMode": {
            "enum": [
              "car",
              "two_wheeler",
              "public_transport",
              "walk_cycle",
              "work_from_home"
            ],
            "title": "Commutemode",
            "type": "string"
          },
          "cookingFuel": {
            "enum": [
              "lpg",
              "induction_electric",
              "piped_gas",
              "biomass_wood"
            ],
            "title": "Cookingfuel",
            "type": "string"
          },
          "hasAirPurifier": {
            "title": "Hasairpurifier",
            "type": "boolean"
          },
          "hasChildren": {
            "title": "Haschildren",
            "type": "boolean"
          },
          "hasElderly": {
            "title": "Haselderly",
            "type": "boolean"
          },
          "hasRespiratoryCondition": {
            "title": "Hasrespiratorycondition",
            "type": "boolean"
          },
          "homeType": {
            "enum": [
              "apartment",
              "independent_house"
            ],
            "title": "Hometype",
            "type": "string"
          },
          "householdSize": {
            "maximum": 20.0,
            "minimum": 1.0,
            "title": "Householdsize",
            "type": "integer"
          },
          "language": {
            "enum": [
              "en",
              "hi"
            ],
