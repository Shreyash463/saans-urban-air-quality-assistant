  "info": {
    "title": "Saans \u2014 Urban Air Quality Assistant API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/air-quality": {
      "get": {
        "description": "Returns live Open-Meteo CPCB-calibrated AQI for a city (never accepts query coordinates).",
        "operationId": "get_air_quality_endpoint_api_air_quality_get",
        "parameters": [
          {
            "in": "query",
            "name": "city",
            "required": false,
            "schema": {
              "default": "Delhi",
              "maxLength": 60,
              "minLength": 1,
              "title": "City",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirQualityReading"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Air Quality Endpoint",
        "tags": [
          "air-quality"
        ]
      },
      "post": {
        "description": "Returns live Open-Meteo AQI for ephemeral coordinates supplied via POST body only.",
        "operationId": "post_air_quality_coords_endpoint_api_air_quality_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoordinatesBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AirQualityReading"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Post Air Quality Coords Endpoint",
        "tags": [
          "air-quality"
        ]
      }
    },
    "/api/chat": {
      "post": {
        "description": "Answers follow-up questions grounded in household profile, active plan, and AQI.",
        "operationId": "chat_endpoint_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatReply"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat Endpoint",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Returns service health status, current healthy model, and short commit SHA.",
        "operationId": "health_check_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health Check",
        "tags": [
          "health"
        ]
      }
    },
    "/api/plan": {
      "post": {
        "description": "Generates a personalized clean-air plan using live AQI, Gemini, safety checks, and fallback.",
        "operationId": "create_plan_endpoint_api_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Plan Endpoint",
        "tags": [
          "plan"
        ]
      }
    }
  }
}
