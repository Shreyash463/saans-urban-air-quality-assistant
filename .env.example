# Runtime mode: development | production | test
# In production, /docs, /redoc, and /openapi.json are disabled by default
ENVIRONMENT=development

# Gemini API key (server-side only; never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override auto-selected flash model (single pinned model)
GEMINI_MODEL=
# Comma-separated model discovery priority (Flash-Lite first for highest free-tier quota)
GEMINI_MODEL_PRIORITY=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash,gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
# Daily upstream Gemini call cap (resets at 00:00 UTC)
GEMINI_DAILY_CALL_BUDGET=400

# Allowed CORS origins (comma-separated, never "*")
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Reverse-proxy IP extraction for rate limiting (enable behind Render/Cloud Run/nginx)
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1

# Frontend configuration
# Leave empty to use same-origin /api (with Vite dev proxy in dev and FastAPI in prod)
VITE_API_BASE_URL=
