# Runtime mode: development | production | test
# In production, /docs, /redoc, and /openapi.json are disabled by default
ENVIRONMENT=development

# Gemini API key (server-side only; never commit real keys)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override auto-selected flash model (e.g. gemini-3.8-flash or gemini-2.5-flash)
GEMINI_MODEL=

# Allowed CORS origins (comma-separated, never "*")
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Reverse-proxy IP extraction for rate limiting (enable behind Render/Cloud Run/nginx)
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_HOPS=1

# Frontend configuration
# Leave empty to use same-origin /api (with Vite dev proxy in dev and FastAPI in prod)
VITE_API_BASE_URL=
# Set to "true" to force built-in client mock mode without calling the backend
VITE_USE_MOCK=false
